{
  "manifest_version": 3,
  "name": "TradingView Trade Sender",
  "version": "1.0",
  "description": "Send TradingView price with trade data to external API",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tradingview.com/*"],
      "js": ["content.js"]
    }
  ]
}
